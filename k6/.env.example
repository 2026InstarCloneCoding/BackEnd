# k6 환경변수 설정 예시
# 복사해서 사용: cp k6/.env.example k6/.env

BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000

# 테스트용 계정 (DataInitializer로 생성된 계정 또는 직접 가입한 계정)
TEST_EMAIL=root@instagram.com
TEST_PASSWORD=root1234

# 팔로워/팔로잉 목록 조회 대상 username (팔로워가 많을수록 N+1 효과 극대화)
TEST_USERNAME=root

# WebSocket 테스트용 채팅방 ID
TEST_ROOM_ID=1
